# ============================================================================
# WEARWISE — VARIABLES DE ENTORNO (.env)
# Copia este archivo a .env y coloca tus llaves reales
# ============================================================================

# 1. SUPABASE (Auth, PostgreSQL, Storage y Edge Functions)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key

# 2. REPLICATE API (Recorte de fondo con 851-labs/background-remover)
# Nota: En producción se recomienda guardarla en Supabase Secrets (npx supabase secrets set REPLICATE_API_TOKEN=r8_...)
# También puedes colocarla aquí para pruebas directas desde el cliente durante el desarrollo:
EXPO_PUBLIC_REPLICATE_API_TOKEN=r8_tu_token_de_replicate
EXPO_PUBLIC_REPLICATE_BG_VERSION=a029dff38972b5fda4ec5d75d7d1cd25aeff621d2cf4946a41055d7db66b80bc

# 3. CLAUDE API (Anthropic — Haiku 5.5 / 4.5 para Auto-etiquetado Vision y Planificador Semanal)
# Nota: En producción se recomienda guardarla en Supabase Secrets (npx supabase secrets set CLAUDE_API_KEY=...)
EXPO_PUBLIC_CLAUDE_API_KEY=sk-ant-api03-tu_clave_claude
EXPO_PUBLIC_CLAUDE_MODEL=claude-haiku-4-5-20251001
