# ============================================================================
# WEARWISE — VARIABLES DE ENTORNO DE LA APP MÓVIL
# Copia este archivo a `.env` y completa los valores de tu proyecto Supabase
# (Project Settings > API). `.env` está en .gitignore.
#
# Para builds EAS define las mismas variables con `eas env:create`.
# REPLICATE_API_TOKEN y CLAUDE_API_KEY NO van aquí: viven en los
# Edge Function Secrets de Supabase.
# ============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<tu-anon-key>
